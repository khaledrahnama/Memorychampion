    "hardhat": "^2.22.0",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.3.11",
    "solc": "0.8.24",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "viem": "^2.56.9"
  }
