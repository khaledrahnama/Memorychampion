# ---------------------------------------------------------------------------
# API settings. Locally, copy to backend/.env. On Vercel, set the same names in
# Project -> Settings -> Environment Variables (the frontend needs none).
# ---------------------------------------------------------------------------

# Long random string used to sign login tokens (required in production).
JWT_SECRET=change-me-to-a-long-random-string

# Password for the Admin page (/admin) and admin API. Admin is disabled if unset in production.
ADMIN_KEY=change-me-too

# Postgres connection string (Neon via the Vercel marketplace sets this for you).
# Leave empty locally to use the built-in embedded Postgres stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.pglite

# Chain — Monad testnet by default.
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
EXPLORER_URL=https://testnet.monadvision.com
# Address printed by `npm run deploy:monad` in contracts/
CONTRACT_ADDRESS=
# Private key of the contract operator (the deployer by default). It funds new
# games from its own MON balance and publishes results — use a dedicated wallet.
OPERATOR_PRIVATE_KEY=

# Email via Resend (https://resend.com). Without it (local dev only), the code
# is shown in the app instead of emailed.
RESEND_API_KEY=
EMAIL_FROM="Monad Memory Challenge <onboarding@resend.dev>"

# Gameplay timing (spec: 5s photo, 5s question).
PHOTO_SECONDS=5
QUESTION_SECONDS=5
